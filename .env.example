# Copy to .env. This is the local server configuration, never browser settings.
# Leave the key empty to keep DeepSeek disabled; offline composition still works.
PORT=4173
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_MAX_TOKENS=16384
LLM_JSON_MODE=1
# DeepSeek always uses JSON output and disabled thinking for this bounded note task.
# Other compatible endpoints keep the existing full-project response protocol.
# For a keyless local model, change LLM_API_URL and LLM_MODEL accordingly.
# Configuration checks make no model calls. Generation/retry may incur provider charges.
# Cancellation ignores late results; it does not guarantee cancellation of billing.
